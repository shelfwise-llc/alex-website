<%= if @post do %>
  <article class="max-w-4xl mx-auto px-6 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-sm text-gray-500 mb-8 fade-in">
      <.link navigate={~p"/"} class="hover:text-purple-600 transition-colors">Home</.link>
      <span class="mx-2">/</span>
      <.link navigate={~p"/blog"} class="hover:text-purple-600 transition-colors">Blog</.link>
      <span class="mx-2">/</span>
      <span class="text-gray-900"><%= @post["title"] %></span>
    </nav>

    <!-- Post Header -->
    <header class="mb-12 fade-in">
      <h1 class="text-4xl md:text-5xl font-light mb-6"><%= @post["title"] %></h1>
      
      <div class="flex flex-wrap gap-3 mb-6">
        <%= for tag <- @post["tags"] || [] do %>
          <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">
            <%= tag %>
          </span>
        <% end %>
      </div>
      
      <div class="flex items-center text-gray-500 mb-8">
        <time datetime={@post["date"]}><%= format_date(@post["date"]) %></time>
        <span class="mx-2">•</span>
        <span><%= @post["readingTime"] %></span>
      </div>
      
      <%= if @post["thumbnail"] do %>
        <div class="aspect-video bg-gray-100 rounded-xl overflow-hidden mb-8 fade-in fade-in-delay-1">
          <img 
            src={@post["thumbnail"]} 
            alt={@post["title"]} 
            class="w-full h-full object-cover" 
          />
        </div>
      <% end %>
    </header>
    
    <!-- Content and TOC -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">
      <!-- Main Content -->
      <div class="lg:col-span-3 prose prose-lg max-w-none fade-in fade-in-delay-2">
        <%= if @post["description"] do %>
          <p class="text-xl text-gray-700 mb-8 not-prose"><%= @post["description"] %></p>
        <% end %>
        
        <%= raw(@post["html"]) %>
        
        <!-- Share Buttons -->
        <div class="border-t border-b py-6 my-8">
          <div class="flex items-center justify-between">
            <span class="font-medium">Share this article</span>
            <div class="flex space-x-4">
              <a href={"https://twitter.com/intent/tweet?text=#{@post["title"]}&url=#{url(~p"/blog/#{@post["slug"]}")}"} target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-blue-400 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                </svg>
              </a>
              <a href={"https://www.facebook.com/sharer/sharer.php?u=#{url(~p"/blog/#{@post["slug"]}")}"} target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-blue-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
              <a href={"https://www.linkedin.com/shareArticle?mini=true&url=#{url(~p"/blog/#{@post["slug"]}")}&title=#{@post["title"]}"} target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-blue-700 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Table of Contents -->
      <%= if @post["toc"] && length(@post["toc"]) > 0 do %>
        <div class="hidden lg:block">
          <div class="sticky top-8 fade-in fade-in-delay-3">
            <h4 class="text-lg font-medium mb-4">Table of Contents</h4>
            <nav class="space-y-2">
              <%= for item <- @post["toc"] do %>
                <a 
                  href={"##{item["id"]}"} 
                  class={[
                    "block text-gray-600 hover:text-purple-600 transition-colors",
                    (if item["level"] == 3, do: "pl-4 text-sm")
                  ]}
                >
                  <%= item["text"] %>
                </a>
              <% end %>
            </nav>
          </div>
        </div>
      <% end %>
    </div>
    
    <!-- Related Posts -->
    <%= if @related_posts && length(@related_posts) > 0 do %>
      <section class="mt-16 pt-8 border-t fade-in">
        <h2 class="text-2xl font-light mb-8">Related Articles</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <%= for post <- @related_posts do %>
            <article class="group">
              <.link navigate={~p"/blog/#{post["slug"]}"} class="block">
                <div class="aspect-video bg-gray-100 rounded-xl overflow-hidden mb-4">
                  <img
                    src={post["thumbnail"] || "https://via.placeholder.com/400x240?text=No+Image"}
                    alt={post["title"]}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <h3 class="text-lg font-medium mb-2 group-hover:text-purple-600 transition-colors">
                  <%= post["title"] %>
                </h3>
                <div class="flex items-center text-sm text-gray-500">
                  <span><%= format_date(post["date"]) %></span>
                  <span class="mx-2">•</span>
                  <span><%= post["readingTime"] %></span>
                </div>
              </.link>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>
    
    <!-- Back to Blog -->
    <div class="mt-12 text-center fade-in">
      <.link navigate={~p"/blog"} class="inline-flex items-center space-x-2 text-purple-600 hover:text-purple-800 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back to Blog</span>
      </.link>
    </div>
  </article>
<% else %>
  <div class="max-w-4xl mx-auto px-6 py-24 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-gray-400 mx-auto mb-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <h1 class="text-3xl font-light mb-4">Post Not Found</h1>
    <p class="text-xl text-gray-600 mb-8">The article you're looking for doesn't exist or has been removed.</p>
    <.link navigate={~p"/blog"} class="gradient-button inline-flex items-center space-x-2 px-6 py-3 text-white rounded-lg transition-all duration-300">
      <span>Back to Blog</span>
    </.link>
  </div>
<% end %>
