<!-- Hero Section -->
<section class="pt-24 pb-16 px-6 max-w-6xl mx-auto text-center">
  <h1 class="text-4xl md:text-6xl font-light tracking-tight leading-tight mb-6 fade-in">
    Latest <span class="gradient-text">Insights</span>
  </h1>
  <p class="text-xl text-gray-600 max-w-2xl mx-auto fade-in fade-in-delay-1">
    Thoughts on design, development, and the intersection of technology and creativity.
  </p>
</section>

<!-- Search and Filters -->
<section class="px-6 pb-12 max-w-6xl mx-auto">
  <div class="flex flex-col md:flex-row gap-4 items-center justify-between fade-in fade-in-delay-2">
    <div class="relative flex-1 max-w-md">
      <.form :let={f} for={%{}} as={:search} phx-submit="search" class="w-full">
        <div class="relative">
          <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
          <%= text_input f, :search_query, value: @search_query, placeholder: "Search articles...", class: "w-full pl-10 pr-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent", phx_debounce: "300" %>
        </div>
      </.form>
    </div>
    <div class="flex gap-2 flex-wrap">
      <%= for category <- @categories do %>
        <button
          phx-click="select_category"
          phx-value-category={category}
          class={[
            "px-4 py-2 rounded-full text-sm font-medium transition-all duration-200",
            if @selected_category == category do
              "bg-purple-600 text-white"
            else
              "bg-gray-100 text-gray-700 hover:bg-gray-200"
            end
          ]}
        >
          <%= category %>
        </button>
      <% end %>
    </div>
  </div>
</section>

<!-- Featured Post -->
<%= if @featured_post do %>
  <section class="px-6 pb-16 max-w-6xl mx-auto">
    <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-2xl p-8 md:p-12 fade-in fade-in-delay-3">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <div class="flex items-center space-x-2 text-sm text-purple-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>Featured Post</span>
          </div>
          <h2 class="text-2xl md:text-3xl font-light mb-4">
            <%= @featured_post["title"] %>
          </h2>
          <p class="text-gray-600 mb-6">
            <%= @featured_post["description"] %>
          </p>
          <div class="flex items-center space-x-4 text-sm text-gray-500 mb-6">
            <span><%= format_date(@featured_post["date"]) %></span>
            <span>•</span>
            <span><%= @featured_post["readingTime"] %></span>
          </div>
          <.link navigate={~p"/blog/#{@featured_post["slug"]}"} class="gradient-button inline-flex items-center space-x-2 px-6 py-3 text-white rounded-lg transition-all duration-300">
            <span>Read Article</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </.link>
        </div>
        <div class="aspect-video bg-white rounded-xl overflow-hidden shadow-lg">
          <img
            src={@featured_post["thumbnail"]}
            alt={@featured_post["title"]}
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>
<% end %>

<!-- Articles Grid -->
<section class="px-6 pb-16 max-w-6xl mx-auto">
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
    <%= for post <- @displayed_posts do %>
      <article
        class="group cursor-pointer fade-in"
        phx-click={JS.navigate(~p"/blog/#{post["slug"]}")}
      >
        <div class="aspect-video bg-gray-100 rounded-xl overflow-hidden mb-4">
          <img
            src={post["thumbnail"] || "https://via.placeholder.com/400x240?text=No+Image"}
            alt={post["title"]}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
        </div>
        <div class="flex flex-wrap gap-2 mb-3">
          <%= for tag <- post["tags"] || [] do %>
            <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs">
              <%= tag %>
            </span>
          <% end %>
        </div>
        <h3 class="text-xl font-medium mb-2 group-hover:text-purple-600 transition-colors">
          <%= post["title"] %>
        </h3>
        <p class="text-gray-600 mb-4 line-clamp-2">
          <%= post["description"] %>
        </p>
        <div class="flex items-center justify-between text-sm text-gray-500">
          <span><%= format_date(post["date"]) %></span>
          <span><%= post["readingTime"] %></span>
        </div>
      </article>
    <% end %>
  </div>

  <!-- Load More Button -->
  <%= if @has_more_posts do %>
    <div class="text-center mt-12 fade-in">
      <button
        phx-click="load_more"
        class="px-8 py-3 border border-gray-200 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors"
      >
        Load More Articles
      </button>
    </div>
  <% end %>

  <!-- No Results -->
  <%= if @filtered_posts == [] do %>
    <div class="text-center py-12">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-gray-400 mx-auto mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        <line x1="11" y1="8" x2="11" y2="14"></line>
        <line x1="8" y1="11" x2="14" y2="11"></line>
      </svg>
      <h3 class="text-xl font-medium text-gray-900 mb-2">No articles found</h3>
      <p class="text-gray-600">Try adjusting your search or filter criteria.</p>
    </div>
  <% end %>
</section>

<!-- Newsletter Subscription -->
<section class="px-6 py-16 bg-gray-50">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-3xl font-light mb-4 fade-in">Stay Updated</h2>
    <p class="text-xl text-gray-600 mb-8 fade-in fade-in-delay-1">
      Get the latest articles and insights delivered to your inbox.
    </p>
    <.form :let={f} for={%{}} as={:newsletter} phx-submit="subscribe" class="max-w-md mx-auto fade-in fade-in-delay-2">
      <div class="flex gap-3">
        <%= email_input f, :email, value: @email, placeholder: "Enter your email", required: true, class: "flex-1 px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent" %>
        <%= submit (if @is_subscribing, do: "Subscribing...", else: "Subscribe"), disabled: @is_subscribing, class: "gradient-button px-6 py-3 text-white rounded-lg transition-all duration-300 disabled:opacity-50" %>
      </div>
      <%= if @subscription_message do %>
        <p class={"mt-3 text-sm #{if @subscription_success, do: "text-green-600", else: "text-red-600"}"}>
          <%= @subscription_message %>
        </p>
      <% end %>
    </.form>
  </div>
</section>
