{
  "url": "https://your-production-url.com/",
  "server": {
    "port": 2368,
    "host": "127.0.0.1"
  },
  "database": {
    "client": "sqlite3",
    "connection": {
      "filename": "${process.env.GHOST_DB_PATH}/content/data/ghost-prod.db"
    }
  },
  "mail": {
    "transport": "SMTP",
    "options": {
      "service": "Mailgun",
      "host": "smtp.mailgun.org",
      "port": 465,
      "secureConnection": true,
      "auth": {
        "user": "${process.env.MAIL_USER}",
        "pass": "${process.env.MAIL_PASSWORD}"
      }
    }
  },
  "logging": {
    "transports": [
      "file",
      "stdout"
    ]
  },
  "process": "systemd",
  "paths": {
    "contentPath": "${process.env.GHOST_CONTENT_PATH}"
  }
}
