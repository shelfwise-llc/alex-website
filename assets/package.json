{
  "name": "assets",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run build.js",
    "watch": "bun run build.js --watch",
    "deploy": "bun run build.js --deploy",
    "css:build": "bunx tailwindcss -i css/app.css -o ../priv/static/assets/app.css",
    "css:watch": "bunx tailwindcss -i css/app.css -o ../priv/static/assets/app.css --watch",
    "css:deploy": "bunx tailwindcss -i css/app.css -o ../priv/static/assets/app.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/bun": "latest",
    "esbuild": "^0.25.9",
    "tailwindcss": "^3.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "phoenix": "^1.8.1",
    "phoenix_html": "^4.2.1",
    "phoenix_live_view": "^1.1.10"
  }
}
